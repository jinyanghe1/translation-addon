{
  "manifest_version": 3,
  "name": "Immersive English-French Translator",
  "version": "1.0",
  "description": "Minimal selection translator using local backend",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
